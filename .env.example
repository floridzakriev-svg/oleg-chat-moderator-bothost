TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here
# LLM provider: Groq; these are the only LLM variables required by the bot.
GROQ_API_KEY=put_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Recommended: set the numeric ID of «Психика на минималках Чат» to isolate moderation.
# Leave empty only if this bot is intentionally used in every group where it is added.
ALLOWED_CHAT_ID=
DB_PATH=./oleg_bot.sqlite3
LOG_LEVEL=INFO
